generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TipoDocumento {
  id          Int     @id @default(autoincrement())
  sintetico   String  @unique
  descripcion String
  partes      Parte[]
}

model Patrocinante {
  id           Int     @id @default(autoincrement())
  nombre       String
  nroMatricula Int     @unique
  domicilio    String?
  localidad    String?
  nroCasillero Int?
  nroWhatsapp  String?
  partes       Parte[]
}

model Parte {
  id              Int              @id @default(autoincrement())
  nombre          String
  idTipoDocumento Int
  nroDocumento    String
  cuil            String
  idPatrocinante  Int?
  nroWhatsapp     String?
  localidad       String?
  domicilio       String?
  patrocinante    Patrocinante?    @relation(fields: [idPatrocinante], references: [id])
  tipoDocumento   TipoDocumento    @relation(fields: [idTipoDocumento], references: [id])
  reclamos        PartesReclamos[]

  @@unique([idTipoDocumento, nroDocumento])
  @@index([idPatrocinante], map: "Parte_idPatrocinante_fkey")
}

model Resolucion {
  id          Int        @id @default(autoincrement())
  descripcion String
  detalle     String     @db.Text
  reclamos    Reclamos[]
}

model Reclamos {
  id              Int              @id @default(autoincrement())
  rubros          String           @db.Text
  idResolucion    Int
  fechaHoraInicio DateTime
  horaFin         DateTime?
  numero          Int
  partes          PartesReclamos[]
  resolucion      Resolucion       @relation(fields: [idResolucion], references: [id])

  @@unique([numero, fechaHoraInicio])
  @@index([idResolucion], map: "Reclamos_idResolucion_fkey")
}

model PartesReclamos {
  id        Int      @id @default(autoincrement())
  idParte   Int
  idReclamo Int
  rol       Int
  parte     Parte    @relation(fields: [idParte], references: [id])
  reclamo   Reclamos @relation(fields: [idReclamo], references: [id])

  @@unique([idParte, idReclamo])
  @@index([idReclamo], map: "PartesReclamos_idReclamo_fkey")
}
