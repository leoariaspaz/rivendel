generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TipoDocumento {
  id          Int     @id @default(autoincrement())
  sintetico   String  @unique
  descripcion String
  partes      Parte[]
}

model Patrocinante {
  id           Int     @id @default(autoincrement())
  nombre       String
  nroMatricula Int     @unique
  domicilio    String?
  localidad    String?
  nroCasillero Int?
  partes       Parte[]
}

model Parte {
  id              Int              @id @default(autoincrement())
  nombre          String
  idTipoDocumento Int
  nroDocumento    String
  cuil            String
  idPatrocinante  Int?
  localidad       String?
  domicilio       String?
  patrocinante    Patrocinante?    @relation(fields: [idPatrocinante], references: [id], onDelete: Restrict)
  esApoderado     Boolean          @default(false)
  tipoDocumento   TipoDocumento    @relation(fields: [idTipoDocumento], references: [id])
  reclamos        PartesReclamos[]
  idUsuario       Int?
  usuario         User?            @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idTipoDocumento, nroDocumento, idUsuario])
  @@index([idPatrocinante], map: "Parte_idPatrocinante_fkey")
}

model Reclamos {
  id               Int              @id @default(autoincrement())
  rubros           String           @db.Text
  idResolucion     Int
  fechaHoraInicio  DateTime
  horaFin          DateTime?
  numero           Int
  proximaAudiencia DateTime?
  idUsuario        Int?
  partes           PartesReclamos[]
  usuario          User?            @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([numero, fechaHoraInicio])
}

model PartesReclamos {
  id                      Int      @id @default(autoincrement())
  idParte                 Int
  idReclamo               Int
  rol                     Int
  nroWhatsappParte        String?
  nroWhatsappPatrocinante String?
  postergo                Boolean  @default(false)
  incomparendo            Boolean  @default(false)
  multado                 Boolean  @default(false)
  parte                   Parte    @relation(fields: [idParte], references: [id], onDelete: Restrict)
  reclamo                 Reclamos @relation(fields: [idReclamo], references: [id], onDelete: Cascade)

  @@unique([idParte, idReclamo])
  @@index([idReclamo], map: "PartesReclamos_idReclamo_fkey")
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  nombre          String?
  nroHabilitacion Int?
  reclamos        Reclamos[]
  password        String
  refreshToken    String? // HASHED refresh token
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  partes          Parte[]
}
