// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model TipoDocumento {
  id Int @default(autoincrement()) @id
  sintetico String @unique
  descripcion String
  partes Parte[]
}

model Patrocinante {
  id Int @id @default(autoincrement())
  nombre String
  nroMatricula Int @unique
  domicilio String?
  localidad String?
  nroCasillero Int?
  partes Parte[]
  nroWhatsapp String?
}

model Parte {
  id Int @id @default(autoincrement())
  nombre String
  idTipoDocumento Int
  tipoDocumento TipoDocumento @relation(fields: [idTipoDocumento], references: [id])
  nroDocumento String
  cuil String
  domicilio String?
  localidad String?
  idPatrocinante Int
  patrocinante Patrocinante @relation(fields: [idPatrocinante], references: [id])
  nroWhatsapp String?
  reclamos PartesReclamos[]

  @@unique([idTipoDocumento, nroDocumento])
}

model Resolucion {
  id Int @id @default(autoincrement())
  descripcion String
  detalle String @db.LongText
  reclamos Reclamos[]
}

model Reclamos {
  id Int @id @default(autoincrement())
  numero Int @unique
  rubros String
  idResolucion Int
  resolucion Resolucion @relation(fields: [idResolucion], references: [id])
  fechaHoraInicio DateTime
  horaFin DateTime
  segundaFecha DateTime?
  segFechaHoraInicio DateTime?
  segHoraFin DateTime?
  partes PartesReclamos[]
}

model PartesReclamos {
  id Int @id @default(autoincrement())
  idParte Int
  parte Parte @relation(fields: [idParte], references: [id])
  idReclamo Int
  reclamo Reclamos @relation(fields: [idReclamo], references: [id])
  rol Int // 1=reclamante, 2=reclamado

  @@unique([idParte, idReclamo])
}